.DS_Store
node_modules/
.env
.env.*
.vscode/
.idea/
dist/
.cache/

# Service-account keys must never be committed — every file here ships to the browser.
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json

# the template is not a secret; the .env it produces is
!deploy/whatsapp/.env.example

# Generated source art. The JPEGs beside them are what the pages load;
# the PNGs are 2 MB of originals, regenerable with scripts/gen-image.mjs.
images/studio-desk.png
images/packing-bench.png
images/crm-flow.png

# Generated video. The clips are regenerable with gen-veo.mjs and the reel
# with cut-30.sh; 10 MB of mp4 does not belong in git history.
marketing/video/out/
images/avatar-host-*.png
# The rendered slides ARE the deliverable — 1080x1350 PNGs the studio posts.
# They were ignored as "regenerable", which is true and beside the point: a
# regenerable file still has to exist somewhere the person posting it can
# reach, and 200 MB of images will not go through a chat upload or a Drive
# tool that takes base64 inline. Committed, they are one download from GitHub.
# The 4K SOURCES stay ignored — those are 7 MB each and genuinely regenerable.
images/hook-*.png
images/bg-*.png

# Deep-research working files. The finished playbook lives in marketing/social/.
research_notes/
reports/

# Generated carousel cover photography. 16 x ~650 KB, regenerable with
# scripts/gen-image.mjs --people followed by scripts/autocrop.cjs.
images/ppl-*.png
images/sc-*.png
images/.gen-log.tsv
marketing/video/fonts/
images/bc-*.png
