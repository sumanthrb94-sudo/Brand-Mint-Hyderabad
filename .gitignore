.DS_Store
# Both forms: the trailing slash matches a real directory, the bare name also
# matches a symlink. tests/README.md has you symlink node_modules from /tmp,
# because ESM ignores NODE_PATH — without the bare form that symlink shows up
# as an untracked file.
node_modules/
node_modules

# Firebase emulator artefacts
firestore-debug.log
firebase-debug.log
ui-debug.log
*-debug.log
.firebase/
.env
.env.*
!.env.example
!**/.env.example

# Firebase service account keys. These are ROOT credentials: they bypass every
# rule in firestore.rules, they never expire, and nothing in this project needs
# one (there is no server — see CLAUDE.md section 3). If a file matching these
# ever appears, do not commit it, do not paste it, revoke it in the console.
*adminsdk*.json
*service-account*.json
*serviceaccount*.json
serviceAccountKey.json
firebase-adminsdk-*.json
*-firebase-adminsdk-*.json

# Hugging Face and other API tokens. tools/brand-video.py reads HF_TOKEN from
# the environment on purpose (see its header) — these lines exist so that the
# usual shortcut, a .env or a token file sitting next to the script, cannot be
# committed by accident. tests/secrets.test.mjs is the second line of defence
# and scans every tracked file for token-shaped strings.
.env
.env.*
!.env.example
*.token
hf_token*
huggingface_token*

# Working files from tools/brand-video.py. The prepared JPEG is a temp file;
# the mp4s and posters ARE brand assets and are committed deliberately, so this
# ignores only the scratch input.
assets/video/_input.jpg
.vscode/
.idea/
dist/
.cache/
.next/
next-env.d.ts
*.tsbuildinfo
docs/journey/*.png
.gstack/
docs/admin-ui/*.png

# Ruflo runtime state. Written into the working directory on use, regardless of
# where the command was run from — §9a names writing into the CWD as a hazard
# and this is it. Machine-local state, not source: it must never reach a public
# repository, and it regenerates, so ignoring beats deleting.
.claude-flow/
.claude/proven-config.json
.claude/.proven-config-version
.swarm/
