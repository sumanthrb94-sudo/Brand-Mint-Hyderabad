rules_version = '2';

// ===========================================================================
// Brand Mint — Firestore security rules.
//
// THIS FILE IS THE SECURITY BOUNDARY. The Firebase apiKey in
// firebase/config.js is public by design and authorises nothing; what stops a
// stranger reading your leads, invoices and bank details is entirely below.
//
// To deploy: Firebase Console → Firestore Database → Rules → paste → Publish.
// (No CLI needed, same as pasting SQL into a database console.)
//
// Two rules of thumb when editing:
//   1. Rules filter DOCUMENTS, not QUERIES. A client-side query that isn't
//      already constrained to what these rules allow is rejected outright.
//      Every portal read carries where("clientId","==",...) for this reason.
//   2. Every get()/exists() below is a billed document read, and there is a
//      fixed budget per request (10 for a single-document operation, 20 for a
//      query). That is why clientId is denormalised onto every document
//      instead of being joined.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------- helpers ------------------------------ */

    function signedIn() { return request.auth != null; }
    function uid()      { return request.auth.uid; }

    // The analogue of the old SQL is_admin(). Reads the caller's own profile.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(uid()))
        && get(/databases/$(database)/documents/profiles/$(uid())).data.role == 'admin';
    }

    // The analogue of my_client_ids(). Membership documents use a composite
    // id so this is one exists() rather than a query.
    function isMember(clientId) {
      return signedIn()
        && exists(/databases/$(database)/documents/clientUsers/$(uid() + '_' + clientId));
    }

    function canSee(clientId) { return isAdmin() || isMember(clientId); }

    // Only ever trust an email address the identity provider verified.
    // Without this check someone could register an unverified address that
    // happens to match an outstanding invite and claim it.
    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email != null;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /* ------------------------------- profiles ----------------------------- */
    // Replaces the guard_profile_role() trigger: a user may edit their own
    // profile but may NOT change their own role. Admins are made by editing
    // the document in the Firebase console — see SETUP-FIREBASE.md.

    match /profiles/{userId} {
      allow get, list: if uid() == userId || isAdmin();

      allow create: if uid() == userId
                    && request.resource.data.role == 'client';

      allow update: if isAdmin()
                    || (uid() == userId
                        && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    /* ----------------------------- memberships ---------------------------- */
    // Replaces the handle_new_user() signup trigger. A user may create
    // exactly their own membership, and only where an invite already exists
    // for their verified address. No invite, no access.

    match /clientUsers/{membershipId} {
      allow get, list: if isAdmin()
                       || (signedIn() && resource.data.uid == uid());

      allow create: if isAdmin()
                    || (verifiedEmail()
                    && membershipId == uid() + '_' + request.resource.data.clientId
                    && request.resource.data.uid == uid()
                    && request.resource.data.role == 'owner'
                    && exists(/databases/$(database)/documents/invites/$(
                         request.auth.token.email + '_' + request.resource.data.clientId)));

      allow update, delete: if isAdmin();
    }

    /* -------------------------------- invites ----------------------------- */
    // Admins manage invites. An invitee may read only their own (so the app
    // can discover which client to join) and may stamp acceptedAt on it.
    //
    // Document id MUST be `{lowercased email}_{clientId}` — rules have no
    // lower(), so the admin app is responsible for writing it lowercased.

    match /invites/{inviteId} {
      allow get, list: if isAdmin()
                       || (verifiedEmail() && resource.data.email == request.auth.token.email);

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
                    || (verifiedEmail()
                        && resource.data.email == request.auth.token.email
                        && changedKeys().hasOnly(['acceptedAt']));
    }

    /* -------------------------------- clients ----------------------------- */
    // A client may read their own record and may only move the onboarding
    // status forward as they fill the brief. Everything else is the admin's.

    match /clients/{clientId} {
      allow get: if canSee(clientId);
      allow list: if isAdmin();   // the portal fetches its client by id

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
                    || (isMember(clientId)
                        && changedKeys().hasOnly(['onboardingStatus'])
                        && request.resource.data.onboardingStatus in ['in_progress', 'submitted']);
    }

    /* --------------------------- projects, invoices ----------------------- */
    // Read-only for the client, scoped by clientId.

    match /projects/{id} {
      allow get:  if canSee(resource.data.clientId);
      allow list: if isAdmin() || isMember(resource.data.clientId);
      allow write: if isAdmin();
    }

    match /invoices/{id} {
      allow get:  if canSee(resource.data.clientId);
      allow list: if isAdmin() || isMember(resource.data.clientId);
      allow write: if isAdmin();
    }

    /* ------------------------------- milestones --------------------------- */

    match /milestones/{id} {
      allow get:  if canSee(resource.data.clientId);
      allow list: if isAdmin() || isMember(resource.data.clientId);
      allow write: if isAdmin();
    }

    /* ------------------------------ deliverables -------------------------- */
    // Replaces the guard_deliverable_review() trigger. A client can approve
    // or request changes, and CANNOT rename the item, re-point its URL or
    // bump its version while doing so. Draft items are invisible to them.

    match /deliverables/{id} {
      allow get: if isAdmin()
                 || (isMember(resource.data.clientId) && resource.data.status != 'draft');

      allow list: if isAdmin()
                  || (isMember(resource.data.clientId) && resource.data.status != 'draft');

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
                    || (isMember(resource.data.clientId)
                        && resource.data.status != 'draft'
                        && request.resource.data.status in ['approved', 'revision_requested']
                        && request.resource.data.reviewedBy == uid()
                        && changedKeys().hasOnly([
                             'status', 'revisionNote', 'reviewedBy', 'reviewedAt', 'updatedAt'
                           ]));
    }

    /* -------------------------------- messages ---------------------------- */
    // Replaces the guard_message_author() and guard_message_edit() triggers.
    // A client cannot post as the agency, cannot post as someone else, and
    // cannot rewrite an existing message — only flip its own read flag.

    match /messages/{id} {
      allow get:  if canSee(resource.data.clientId);
      allow list: if isAdmin() || isMember(resource.data.clientId);

      allow create: if canSee(request.resource.data.clientId)
                    && request.resource.data.authorId == uid()
                    && request.resource.data.authorRole == (isAdmin() ? 'admin' : 'client');

      allow update: if (isAdmin() && changedKeys().hasOnly(['readByAdmin']))
                    || (isMember(resource.data.clientId)
                        && changedKeys().hasOnly(['readByClient']));

      allow delete: if isAdmin();
    }

    /* ------------------------- onboarding responses ----------------------- */
    // Document id is the clientId, so there is exactly one brief per client.

    match /onboardingResponses/{clientId} {
      allow get, list: if canSee(clientId);

      allow create, update: if canSee(clientId)
                            && request.resource.data.clientId == clientId;

      allow delete: if isAdmin();
    }

    /* --------------------------------- leads ------------------------------ */
    // The public contact form writes here unauthenticated. Nobody but an
    // admin can read them back.
    //
    // Shape is pinned so the open create rule can't be used to dump arbitrary
    // documents into the project.

    match /leads/{id} {
      // A visitor who signed in and picked a tier. uid is pinned to the
      // caller so nobody can file a lead as someone else; the shape is
      // pinned so this can't be used as free storage.
      allow create: if signedIn()
                    && request.resource.data.uid == uid()
                    && request.resource.data.keys().hasOnly([
                         'uid', 'name', 'email', 'phone', 'company', 'tier', 'budget',
                         'projectType', 'message', 'source', 'status', 'score',
                         'newsletter', 'createdAt', 'updatedAt'
                       ])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 320
                    && request.resource.data.tier is string
                    && request.resource.data.tier in ['whatsapp', 'starter', 'growth', 'commerce',
                                                   'website', 'platform', 'crm', 'hr']
                    && request.resource.data.status == 'new';

      // A person may read their own leads (the portal shows what they picked).
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == uid());
      allow update, delete: if isAdmin();
    }

    match /requests/{id} {
      // A signed-in person asking for a free perk or pre-booking a trial.
      // uid is pinned to the caller; the shape is pinned so this can't be
      // used as free storage. The studio works these from Admin → Leads.
      allow create: if signedIn()
                    && request.resource.data.uid == uid()
                    && request.resource.data.keys().hasOnly([
                         'uid', 'name', 'email', 'kind', 'item', 'label',
                         'status', 'createdAt', 'updatedAt'
                       ])
                    && request.resource.data.kind in ['perk', 'prebook']
                    && request.resource.data.item is string
                    && request.resource.data.item.size() <= 64
                    && request.resource.data.label is string
                    && request.resource.data.label.size() <= 120
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 320
                    && request.resource.data.status == 'new';
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == uid());
      allow update, delete: if isAdmin();
    }

    match /events/{id} {
      // First-party analytics from shared/analytics.js. Anyone may append
      // one event of a pinned shape; only the studio can read. A uid may be
      // claimed only by the signed-in owner of that uid.
      allow create: if request.resource.data.keys().hasOnly([
                         't', 'ts', 'path', 'sid', 'aid', 'uid', 'vw', 'vh', 'dev', 'dh',
                         'x', 'y', 'xr', 'yr', 'el', 'txt', 'href', 'ref', 'utm', 'lang',
                         'sec', 'depth', 'secs', 'n', 'p'
                       ])
                    && request.resource.data.t in ['page_view', 'click', 'scroll', 'section', 'leave', 'event']
                    && request.resource.data.ts is string && request.resource.data.ts.size() <= 40
                    && request.resource.data.path is string && request.resource.data.path.size() <= 200
                    && request.resource.data.sid is string && request.resource.data.sid.size() <= 24
                    && request.resource.data.aid is string && request.resource.data.aid.size() <= 24
                    && (!('uid' in request.resource.data)
                        || request.resource.data.uid == ''
                        || (request.auth != null && request.resource.data.uid == request.auth.uid))
                    && (!('el' in request.resource.data) || request.resource.data.el.size() <= 80)
                    && (!('txt' in request.resource.data) || request.resource.data.txt.size() <= 60)
                    && (!('href' in request.resource.data) || request.resource.data.href.size() <= 200)
                    && (!('ref' in request.resource.data) || request.resource.data.ref.size() <= 100)
                    && (!('utm' in request.resource.data) || request.resource.data.utm.size() <= 120)
                    && (!('n' in request.resource.data) || request.resource.data.n.size() <= 40)
                    && (!('p' in request.resource.data) || request.resource.data.p.size() <= 300);
      allow get, list: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /bookings/{id} {
      // Call requests from the public booking form. Nobody is signed in, so
      // this is open to create with a hard-pinned shape and size — the same
      // treatment as /events. Only the studio can ever read one back.
      allow create: if request.resource.data.keys().hasOnly([
                         'name', 'phone', 'email', 'service', 'when', 'note',
                         'source', 'status', 'createdAt'
                       ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() > 0
                    && request.resource.data.phone.size() <= 20
                    && request.resource.data.email.size() <= 320
                    // NOTE: `service` is a reserved word in this language
                    // (`service cloud.firestore` above), so dot access on a
                    // field of that name does not compile. Brackets do.
                    && request.resource.data['service'].size() <= 60
                    && request.resource.data.when.size() <= 60
                    && request.resource.data.note.size() <= 1000
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt is string
                    && request.resource.data.createdAt.size() <= 40;
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /waMessages/{id} {
      // Inbound WhatsApp messages, written by api/wa-hook.js from the
      // Evolution box. That endpoint holds a shared secret, but it writes with
      // the public web apiKey like every other REST write here, so as far as
      // these rules are concerned the caller is anonymous — the same treatment
      // as /bookings: open to create, shape and size hard-pinned, readable
      // only by the studio. A leaked secret then buys bounded junk rows, not
      // an arbitrary write. The doc id is the WhatsApp message id, so a
      // retried delivery collides instead of duplicating.
      //
      // status is 'done' once the autosend worker (deploy/whatsapp/
      // autosend-worker.mjs) has sent the drafted reply, or 'new' while the
      // draft is still pending/waiting on a human — same two states the
      // admin panel expects. autoSendState tracks the worker's own pipeline
      // ('pending' -> 'sent'/'skipped') separately from that display status.
      allow create: if request.resource.data.keys().hasOnly([
                         'from', 'name', 'text', 'waId', 'instance', 'status', 'createdAt',
                         'suggestedReply', 'sendAfter', 'autoSendState', 'autoSent', 'sentAt'
                       ])
                    && request.resource.data.from is string
                    && request.resource.data.from.size() > 0
                    && request.resource.data.from.size() <= 20
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.waId is string
                    && request.resource.data.waId.size() <= 64
                    && request.resource.data.instance is string
                    && request.resource.data.instance.size() <= 40
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt is string
                    && request.resource.data.createdAt.size() <= 40
                    && (!('suggestedReply' in request.resource.data)
                        || (request.resource.data.suggestedReply is string
                            && request.resource.data.suggestedReply.size() <= 1000))
                    && (!('sendAfter' in request.resource.data)
                        || (request.resource.data.sendAfter is string
                            && request.resource.data.sendAfter.size() <= 40))
                    && (!('autoSendState' in request.resource.data)
                        || request.resource.data.autoSendState == 'pending')
                    && (!('autoSent' in request.resource.data)
                        || request.resource.data.autoSent is bool)
                    && (!('sentAt' in request.resource.data)
                        || (request.resource.data.sentAt is string
                            && request.resource.data.sentAt.size() <= 40));
      allow get: if isAdmin();

      // Admin sees everything; the autosend worker's query is bounded to
      // exactly the documents it's allowed to act on (still-pending drafts)
      // by the same per-document check its update rule below uses — a
      // crafted query can never surface anything else, so this doesn't
      // widen what an anonymous caller can read beyond that narrow slice.
      allow list: if isAdmin() || resource.data.autoSendState == 'pending';

      // The autosend worker runs on the Evolution VM with no Firebase Auth
      // token (same anonymous-write posture as wa-hook.js's create above),
      // so it needs its own narrow allowance: it may only flip a 'pending'
      // draft to 'sent' or 'skipped', touching nothing but these four
      // fields. It can never create a doc, rewrite the message text, or
      // touch a doc it didn't itself schedule.
      allow update: if isAdmin()
                    || (resource.data.autoSendState == 'pending'
                        && changedKeys().hasOnly(['autoSendState', 'autoSent', 'sentAt', 'status'])
                        && request.resource.data.autoSendState in ['sent', 'skipped']
                        && (!('autoSent' in request.resource.data) || request.resource.data.autoSent is bool)
                        && (!('sentAt' in request.resource.data)
                            || (request.resource.data.sentAt is string && request.resource.data.sentAt.size() <= 40))
                        && (!('status' in request.resource.data) || request.resource.data.status in ['new', 'done']));
      allow delete: if isAdmin();
    }

    match /waConversations/{id} {
      // The running thread with one contact — both sides of it — read back by
      // api/wa-hook.js so the model can see where it is in a conversation
      // instead of greeting a returning customer as a stranger.
      //
      // Same anonymous caller as waMessages: that endpoint holds a shared
      // secret but writes with the public web apiKey, so these rules see no
      // identity. What protects a thread here is its document id, which is a
      // SHA-256 of the phone number and that same shared secret — unguessable
      // without the secret, unlike the phone number itself. Reads are open
      // because the server has no auth token to read with, and a caller who
      // cannot derive an id cannot ask for one.
      allow get: if true;
      // Listing would hand back every conversation at once and defeat the
      // unguessable id entirely.
      allow list: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['turns', 'updatedAt'])
                            && request.resource.data.turns is string
                            && request.resource.data.turns.size() <= 8000
                            && request.resource.data.updatedAt is string
                            && request.resource.data.updatedAt.size() <= 40;
      allow delete: if isAdmin();
    }

    match /waAutoSendCounters/{id} {
      // Per-contact-per-day auto-send counters read and written by
      // api/wa-hook.js to enforce WA_AUTOSEND_DAILY_CAP. Same anonymous
      // caller as waMessages above; a count is not sensitive, so reads are
      // open too — the server has no Firebase Auth token to read it back
      // with otherwise. Shape hard-pinned like every other anonymous write.
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['count', 'updatedAt'])
                            && request.resource.data.count is int
                            && request.resource.data.count >= 0
                            && request.resource.data.count <= 1000
                            && request.resource.data.updatedAt is string
                            && request.resource.data.updatedAt.size() <= 40;
      allow delete: if isAdmin();
    }

    match /formLeads/{id} {
      // Form auto-saves and submissions from shared/form-automation.js. Anyone
      // may create with a hard-pinned shape and size (same as /bookings and
      // /events). Captures partial fills even if abandoned. Only the studio can
      // read. Admin access from API endpoints keeps the rule open.
      allow create: if request.resource.data.keys().hasOnly([
                         'email', 'name', 'phone', 'service', 'message', 'when',
                         'status', 'source', 'createdAt', 'updatedAt',
                         'submittedAt', 'leadId'
                       ])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 320
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 20
                    && request.resource.data['service'] is string
                    && request.resource.data['service'].size() <= 60
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.when is string
                    && request.resource.data.when.size() <= 60
                    && request.resource.data.status is string
                    && request.resource.data.status in ['draft', 'submitted']
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 60
                    && request.resource.data.createdAt is string
                    && request.resource.data.createdAt.size() <= 40
                    && request.resource.data.updatedAt is string
                    && request.resource.data.updatedAt.size() <= 40
                    && (!('submittedAt' in request.resource.data)
                        || request.resource.data.submittedAt.size() <= 40)
                    && (!('leadId' in request.resource.data)
                        || request.resource.data.leadId.size() <= 20);
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /formWaMessages/{id} {
      // WhatsApp messages triggered by form submissions, written by
      // api/form-wa-trigger.js. Anonymous create with hard-pinned shape.
      // Tracks outbound personalized messages sent via Evolution API.
      allow create: if request.resource.data.keys().hasOnly([
                         'leadId', 'phone', 'name', 'service', 'message',
                         'status', 'source', 'createdAt'
                       ])
                    && request.resource.data.leadId is string
                    && request.resource.data.leadId.size() <= 20
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 20
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 80
                    && request.resource.data['service'] is string
                    && request.resource.data['service'].size() <= 60
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.status is string
                    && request.resource.data.status.size() <= 20
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 60
                    && request.resource.data.createdAt is string
                    && request.resource.data.createdAt.size() <= 40;
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /importedLeads/{id} {
      // Bulk-imported prospects from scrape-leads.js. Same shape as formLeads.
      // Admin-only read/write. Source: 'csv-import' or other bulk imports.
      allow create: if request.resource.data.keys().hasOnly([
                         'name', 'phone', 'email', 'service',
                         'status', 'source', 'createdAt'
                       ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 20
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 320
                    && request.resource.data['service'] is string
                    && request.resource.data['service'].size() <= 60
                    && request.resource.data.status is string
                    && request.resource.data.status.size() <= 20
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 60
                    && request.resource.data.createdAt is string
                    && request.resource.data.createdAt.size() <= 40;
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /campaigns/{id} {
      // Campaign records: name, target list, message template, send stats.
      // Admin-only. Tracks: sent count, delivered, response rate, sent/completed timestamps.
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /* --------------------------- content, settings ------------------------ */
    // Admin only. Settings carries bank details and GSTIN.

    match /content/{id}  { allow read, write: if isAdmin(); }
    match /settings/{id} { allow read, write: if isAdmin(); }

    /* --------------------------------- deny ------------------------------- */
    // Anything not matched above is denied. Adding a collection to the app
    // means adding a rule here, or it simply will not work — which is the
    // failure mode we want.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
