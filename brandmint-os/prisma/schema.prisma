// Real schema, ready for when you move off demo data.
//   npx prisma init && npx prisma migrate dev --name init
// Then replace the function bodies in lib/db.ts with Prisma queries.
// Nothing in app/ needs to change.

generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

model Organisation {
  id        String   @id @default(cuid())
  name      String
  type      String   // studio | client
  retainer  Int      @default(0)
  createdAt DateTime @default(now())
  users     User[]
  projects  Project[]
  invoices  Invoice[]
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String       // scrypt "salt:hash" — never plaintext
  name         String
  role         String       // admin | client
  org          Organisation @relation(fields: [orgId], references: [id])
  orgId        String
  createdAt    DateTime     @default(now())
}

model Project {
  id           String        @id @default(cuid())
  org          Organisation  @relation(fields: [orgId], references: [id])
  orgId        String
  name         String
  type         String
  status       String        // onboarding | in_progress | review | shipped
  progress     Int           @default(0)
  startedAt    DateTime
  dueAt        DateTime
  milestones   Milestone[]
  intakeItems  IntakeItem[]
  deliverables Deliverable[]
  invoices     Invoice[]
}

model Milestone {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  title     String
  owner     String   // us | client  <- the field that changes conversations
  status    String   // todo | in_progress | blocked | done
  dueAt     DateTime
}

model IntakeItem {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  label     String
  help      String
  kind      String   // asset | content | access | decision
  done      Boolean  @default(false)
  raisedAt  DateTime @default(now())
  clearedAt DateTime?
}

model Deliverable {
  id        String    @id @default(cuid())
  project   Project   @relation(fields: [projectId], references: [id])
  projectId String
  title     String
  url       String
  version   Int       @default(1)
  status    String    // in_review | approved | changes_requested
  note      String?
  decidedAt DateTime?
  decidedBy String?
}

model Invoice {
  id               String       @id @default(cuid())
  org              Organisation @relation(fields: [orgId], references: [id])
  orgId            String
  project          Project?     @relation(fields: [projectId], references: [id])
  projectId        String?
  label            String
  amount           Int
  status           String       // paid | due | scheduled
  dueAt            DateTime
  paidAt           DateTime?
  razorpayId       String?
}

model Lead {
  id                String   @id @default(cuid())
  name              String
  source            String
  stage             String
  value             Int      @default(0)
  createdAt         DateTime @default(now())
  firstResponseAt   DateTime?   // instrument this above all else
}

model Activity {
  id         String   @id @default(cuid())
  orgId      String
  actor      String
  verb       String
  objectType String
  objectId   String
  at         DateTime @default(now())
}
